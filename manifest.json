{
  "manifest_version": 3,
  "name": "Editor",
  "version": "0.4.0",
  "description": "Editor de jogadores e times para o Moba GM (mobagm.com), em português, inglês e espanhol. Edita o save local direto no IndexedDB.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mobagm.com/*",
        "https://www.mobagm.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
